# Wanderly AI — Environment Configuration

# ─── Supabase (auto-provisioned) ───
# These are already set in your .env file. Do not change them.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── AI Provider (OpenAI) ───
# Set this as an Edge Function secret in Supabase (not in .env).
# When unset, the AI assistant runs in demo mode with curated responses.
# OPENAI_API_KEY=sk-your-openai-api-key

# ─── Maps Provider ───
# The app uses OpenStreetMap (free, no key required) for map tiles.
# To use Google Maps or Mapbox instead, add your API key here:
# VITE_MAPBOX_TOKEN=your_mapbox_access_token
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Weather Provider (optional) ───
# Not currently implemented. If added in the future:
# VITE_OPENWEATHER_API_KEY=your_openweather_api_key

# ─── Currency Exchange (optional) ───
# Not currently implemented. If added in the future:
# VITE_EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
